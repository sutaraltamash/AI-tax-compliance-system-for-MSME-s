# ---------------------------------------------------------------------------
# Tax Assistant Server — environment configuration template
# Copy to .env (git-ignored) and fill in credentials. The server reads these
# via the --env-vars / env_map mechanism at startup.
# ---------------------------------------------------------------------------

# --- Network server settings ---
PORT=8080
HOST=0.0.0.0

# --- AI integration (Phase 2 live mode; not needed for mock mode) ---
# AI_MODE=mock        # "mock" -> MockExtractor (offline fixtures), "live" -> Gemini Pro
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-2.5-pro-preview
GEMINI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-pro-preview:generateContent

# --- File paths (all relative to project root) ---
DATABASE_PATH=./database/tax_sessions.db
RULES_CONFIG_PATH=./config/rules_2026.json
GEMINI_SCHEMA_PATH=./config/gemini_schema.json